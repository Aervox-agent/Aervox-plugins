{
  "apiVersion": "aervox.dev/v1",
  "kind": "PluginManifest",
  "requires": {
    "hostApiVersion": {
      "min": "1.1.0",
      "maxExclusive": "2.0.0"
    }
  },
  "metadata": {
    "id": "ap-ui-example",
    "displayName": "ui-page",
    "publisher": "example-author",
    "version": "1.0.0",
    "category": "ui",
    "tags": [],
    "breaking": false,
    "license": "AGPL-3.0-or-later"
  },
  "spec": {
    "pages": [
      {
        "id": "settings",
        "title": "设置示例",
        "entry": "pages/settings/index.html",
        "capabilities": [
          "config.read",
          "host.close"
        ]
      }
    ],
    "config": {
      "schemaVersion": 1,
      "entry": "config.schema.json"
    }
  }
}
