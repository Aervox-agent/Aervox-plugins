{
  "apiVersion": "aervox.dev/v1",
  "kind": "PluginManifest",
  "requires": {
    "hostApiVersion": {
      "min": "1.1.0",
      "maxExclusive": "2.0.0"
    }
  },
  "metadata": {
    "id": "ap-proactive-example",
    "displayName": "proactive-sensor",
    "publisher": "example-author",
    "version": "1.0.0",
    "category": "proactive",
    "tags": [],
    "breaking": false,
    "license": "AGPL-3.0-or-later"
  },
  "spec": {
    "proactive": {
      "sensors": [
        {
          "sourceId": "system.idle_state",
          "description": "读取键鼠空闲时长以评估工作专注度与在座状态（仅元数据，不含窗口内容）"
        }
      ],
      "triggers": [
        {
          "ruleId": "sedentary_alert",
          "name": "连续久坐健康提醒",
          "triggerType": "system_state",
          "condition": {
            "continuousActiveMinutesMin": 50,
            "idleMinutesMax": 5
          },
          "cooldownSeconds": 1800,
          "quietHoursPolicy": "respect_global",
          "petPresentation": {
            "animation": "stretch_body",
            "bubblePreset": "gentle_care"
          }
        }
      ]
    }
  }
}
